$ mcpdial --json tools web --long
exit 0
--- stdout
{
  "tools": [
    {
      "description": "Echo a message back.\nSecond line.",
      "inputSchema": {
        "properties": {
          "message": {
            "description": "What to echo",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "name": "echo"
    },
    {
      "annotations": {
        "idempotentHint": true
      },
      "description": "Add two numbers.",
      "inputSchema": {
        "properties": {
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        },
        "required": [
          "a",
          "b"
        ],
        "type": "object"
      },
      "name": "add",
      "outputSchema": {
        "properties": {
          "sum": {
            "type": "number"
          }
        },
        "required": [
          "sum"
        ],
        "type": "object"
      }
    }
  ]
}
